{
  "realm": "wallet",
  "displayName": "Wallet sign-in",
  "enabled": true,
  "registrationAllowed": false,
  "loginTheme": "su-engineering",
  "identityProviders": [
    {
      "alias": "oid4vp",
      "displayName": "Sign in with Wallet",
      "providerId": "oid4vp",
      "enabled": false,
      "trustEmail": false,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "enforceHaip": "true",
        "walletScheme": "openid4vp://",
        "sameDeviceEnabled": "true",
        "crossDeviceEnabled": "true",
        "userMappingClaim": "sub"
      }
    }
  ],
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "oid4vp-signing",
        "providerId": "ecdsa-generated",
        "config": {
          "priority": [
            "100"
          ],
          "enabled": [
            "true"
          ],
          "active": [
            "true"
          ],
          "algorithm": [
            "ES256"
          ]
        }
      }
    ]
  },
  "authenticationFlows": [
    {
      "alias": "wallet-browser",
      "description": "Sign in directly with a wallet",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "authenticatorConfig": "wallet-redirect",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "wallet-redirect",
      "config": {
        "defaultProvider": "oid4vp"
      }
    }
  ],
  "browserFlow": "wallet-browser"
}
