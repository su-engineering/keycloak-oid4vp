# =============================================================================
# Keycloak OID4VP Extension - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# In Coolify, set these as environment variables in the resource settings
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION (Required)
# =============================================================================
# PostgreSQL connection URL
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak

# Database username (used by both Keycloak and PostgreSQL)
KC_DB_USERNAME=keycloak

# Database password (required; the Compose file does not start without it)
# This is used by both Keycloak and PostgreSQL
KC_DB_PASSWORD=CHANGE_ME_IN_COOLIFY

# =============================================================================
# KEYCLOAK ADMIN CONFIGURATION (Required)
# =============================================================================
# Temporary bootstrap admin, created only when the master realm has no admin yet.
# Replaces KEYCLOAK_ADMIN / KEYCLOAK_ADMIN_PASSWORD, which Keycloak 26 deprecated.
KC_BOOTSTRAP_ADMIN_USERNAME=admin

# Bootstrap admin password (required; the Compose file does not start without it)
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_IN_COOLIFY

# =============================================================================
# HOSTNAME CONFIGURATION
# =============================================================================
# Leave blank. Coolify sets SERVICE_URL_KEYCLOAK, which the Compose file passes to
# KC_HOSTNAME and KC_HOSTNAME_ADMIN (Keycloak hostname v2 options).

# Realm imported on first startup. Existing database-backed realms are not updated.
OID4VP_REALM_IMPORT=deployment/realm-import.json
# Existing OpenKYC deployments: deployment/examples/realm-openkyc.json

# =============================================================================
# KEYCLOAK OPTIONS (Defaults are usually fine)
# =============================================================================
# Database type
KC_DB=postgres

# HTTP settings (required for Coolify reverse proxy)
KC_HTTP_ENABLED=true
KC_HOSTNAME_STRICT=false
KC_PROXY_HEADERS=xforwarded

# Health and metrics
KC_HEALTH_ENABLED=true
