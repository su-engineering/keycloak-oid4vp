# =============================================================================
# Keycloak OID4VP Extension - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# In Coolify, set these as environment variables in the resource settings
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION (Required)
# =============================================================================
# PostgreSQL connection URL
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak

# Database username (used by both Keycloak and PostgreSQL)
KC_DB_USERNAME=keycloak

# Database password - SET A STRONG PASSWORD IN PRODUCTION
# This is used by both Keycloak and PostgreSQL
KC_DB_PASSWORD=CHANGE_ME_IN_COOLIFY

# =============================================================================
# KEYCLOAK ADMIN CONFIGURATION (Required)
# =============================================================================
# Default admin username
KEYCLOAK_ADMIN=admin

# Default admin password - SET A STRONG PASSWORD IN PRODUCTION
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_IN_COOLIFY

# =============================================================================
# HOSTNAME CONFIGURATION
# =============================================================================
# Leave blank - Coolify will auto-set this to the service FQDN
# KC_HOSTNAME will be automatically injected by Coolify

# =============================================================================
# KEYCLOAK OPTIONS (Defaults are usually fine)
# =============================================================================
# Database type
KC_DB=postgres

# HTTP settings (required for Coolify reverse proxy)
KC_HTTP_ENABLED=true
KC_HOSTNAME_STRICT=false
KC_PROXY_HEADERS=xforwarded

# Health and metrics
KC_HEALTH_ENABLED=true